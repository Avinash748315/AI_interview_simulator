# Clarivo local configuration
# Copy the backend block to backend/.env and the frontend block to frontend/.env.local.
# Never commit real keys. Leave provider keys blank to run the local adaptive interviewer,
# browser speech, and the labelled test-payment mode.

# --- backend/.env ---
DATABASE_URL=sqlite:///./clarivo.db
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
AI_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_TEST_SECRET=clarivo_local_test_secret

# --- frontend/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:8000
